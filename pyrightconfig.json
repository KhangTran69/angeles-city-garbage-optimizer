{
  "include": ["."],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".pytest_cache",
    ".venv",
    "**/.venv*",
    "cache",
    "exports"
  ],
  "extraPaths": ["."],
  "typeCheckingMode": "basic",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["."]
    }
  ],
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "reportUnusedImport": "warning",
  "reportOptionalSubscript": "warning"
}
